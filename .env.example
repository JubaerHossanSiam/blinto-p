# HRMS API origin including the API prefix.
# Production example: https://hrms.blinto.co/api/v1
NEXT_PUBLIC_HRMS_API_URL=https://hrms.blinto.co/api/v1

# Neon Postgres
DATABASE_URL=postgresql://USER:PASSWORD@HOST/DB?sslmode=require

# Better Auth
BETTER_AUTH_URL=http://localhost:3000
BETTER_AUTH_SECRET=replace-with-a-long-random-secret

# Google OAuth
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
