# Copy to .env.local for local development. Production values are NOT read from
# this file or from .env.local — both are gitignored and never reach Vercel.
# Everything below marked "Vercel" must be entered in
# Project → Settings → Environment Variables, then REDEPLOYED: env vars are
# baked in at build time, so an existing deployment keeps its old values.


# ─── Better Auth ────────────────────────────────────────────────────────────
# REQUIRED in every environment.
#
# The exact origin the browser uses. Scheme included, no trailing slash, no
# path — Better Auth appends /api/auth/callback/google to it to build the
# Google redirect_uri, so a path here silently corrupts that URL.
#
# Vercel (Production + Preview): https://blinto-p.vercel.app
#
# Do not leave this unset on Vercel. Better Auth then derives the origin from
# the incoming request, which resolves to the per-deployment hostname
# (e.g. blinto-amcxnbh82-ac-bf97.vercel.app). That hostname changes on every
# deploy and is not registered with Google, which produces
# "Error 400: redirect_uri_mismatch" — and, on requests that carry a cookie,
# a 403 "Invalid origin" from the origin check instead.
BETTER_AUTH_URL=http://localhost:3000

# Optional. Comma-separated extra origins allowed to POST to /api/auth/*.
# BETTER_AUTH_URL and the Vercel deployment hostnames are already trusted, so
# this is only for a custom domain, a tunnel, or reaching the dev server as
# 127.0.0.1 instead of localhost.
# BETTER_AUTH_TRUSTED_ORIGINS=http://127.0.0.1:3000

# REQUIRED. Signs session cookies. Generate with: openssl rand -base64 32
# Use a different value locally than in production; rotating it invalidates
# every active session.
BETTER_AUTH_SECRET=replace-with-a-long-random-secret


# ─── Google OAuth ───────────────────────────────────────────────────────────
# REQUIRED. Create at https://console.cloud.google.com/apis/credentials
#
# Authorised JavaScript origins:
#   http://localhost:3000
#   https://blinto-p.vercel.app
#
# Authorised redirect URIs (must match BETTER_AUTH_URL exactly):
#   http://localhost:3000/api/auth/callback/google
#   https://blinto-p.vercel.app/api/auth/callback/google
#
# Never register a per-deployment *.vercel.app hostname here — they are
# regenerated on every deploy. Preview builds deliberately complete sign-in on
# the production domain for this reason.
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=


# ─── Neon Postgres ──────────────────────────────────────────────────────────
# REQUIRED. Holds sessions and the approved_users allow-list; without it every
# Google account is rejected as unapproved and sign-in cannot complete.
DATABASE_URL=postgresql://USER:PASSWORD@HOST/DB?sslmode=require


# ─── HRMS ───────────────────────────────────────────────────────────────────
# Origin including the API prefix. Exposed to the browser (NEXT_PUBLIC_).
NEXT_PUBLIC_HRMS_API_URL=https://hrms.blinto.co/api/v1

# Optional, but KPI 1 needs it: without it attendance and leave scores render
# as an error state rather than pending.
HRMS_API_KEY=


# ─── ClickUp ────────────────────────────────────────────────────────────────
# Optional. Task-level KPI evidence is unavailable without a token.
CLICKUP_API_TOKEN=

# Defaults to 9018782844 when unset.
CLICKUP_WORKSPACE_ID=9018782844

# Required only if the ClickUp webhook is in use: /api/integrations/clickup/webhook
# is public at the proxy layer and authenticates purely on this HMAC secret, so
# leaving it unset makes the route reject every delivery.
CLICKUP_WEBHOOK_SECRET=

# ClickUp user id whose ratings carry CEO authority. Defaults to 3800999.
CLICKUP_CEO_USER_ID=


# ─── Cron ───────────────────────────────────────────────────────────────────
# Vercel sends this as "Authorization: Bearer <value>" to the monthly close job
# in vercel.json. When unset the route accepts unauthenticated calls, so set it
# in Production.
CRON_SECRET=


# ─── Injected by Vercel — do not set these yourself ─────────────────────────
# VERCEL                          "1" on any Vercel deployment
# VERCEL_PROJECT_PRODUCTION_URL   stable production hostname, no scheme
# VERCEL_URL                      hostname of this specific deployment
